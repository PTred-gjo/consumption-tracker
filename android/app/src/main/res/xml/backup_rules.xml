<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and below (android:fullBackupContent).

  All user data lives in the WebView's localStorage under app_webview, so that
  directory is what makes a backup worth having. Cache directories need no rule
  here: the platform never includes them, and naming a "cache" domain is not
  valid in this file.
-->
<full-backup-content>
    <include domain="file" path="app_webview" />
    <!-- Regenerates on its own and would only bloat the archive. -->
    <exclude domain="file" path="app_webview/Default/Service Worker" />
</full-backup-content>
