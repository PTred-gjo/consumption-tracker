{
  "name": "fuelpilot",
  "private": true,
  "version": "1.0.0",
  "description": "Fuel consumption, cost-per-kilometre and vehicle maintenance tracker. Offline-first, no account, all data on device.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:privacy && vite build",
    "build:privacy": "node scripts/build-privacy-page.mjs",
    "preview": "vite preview --port 4173",
    "lint": "eslint . --ext .js,.jsx,.mjs",
    "lint:fix": "eslint . --ext .js,.jsx,.mjs --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/smoke.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "store:graphic": "node scripts/generate-feature-graphic.mjs",
    "store:screenshots": "node scripts/generate-screenshots.mjs",
    "store:assets": "npm run icons && npm run store:graphic && npm run store:screenshots",
    "check": "npm run lint && npm run test && npm run build",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android",
    "build:android": "vite build && cap sync android",
    "android:apk": "npm run build:android && cd android && ./gradlew assembleRelease",
    "android:bundle": "npm run build:android && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/local-notifications": "^6.1.3",
    "chart.js": "^4.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "playwright": "^1.62.1",
    "vite": "^5.4.2",
    "vitest": "^2.1.0"
  }
}
